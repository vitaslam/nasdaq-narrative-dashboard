+function weeklyXTopics(topics,start,carryOnly=false){
+ const first=add(start,-3),end=carryOnly?start:add(start,7);
+ const day=new Intl.DateTimeFormat('en-CA',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit'});
+ return (topics||[]).map(topic=>({...topic,posts:(topic.posts||[]).filter(post=>{
+  const time=Date.parse(post.published_at);if(!Number.isFinite(time))return false;
+  const date=day.format(new Date(time));return date>=first&&date<end;
+ })})).filter(topic=>topic.posts.length);
+}
+function weeklyXTrends(trends,topics){
+ const posts=new Map(topics.flatMap(topic=>topic.posts.map(post=>[post.id,post])));
+ return (trends||[]).filter(trend=>{
+  const evidence=[...new Set(trend.evidence_post_ids||[])].map(id=>posts.get(id)).filter(Boolean);
+  return evidence.length>=2&&new Set(evidence.map(post=>String(post.author).toLowerCase())).size>=2;
+ });
